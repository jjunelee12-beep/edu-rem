{
  "rewrites": [
    {
      "source": "/staff/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(kakaotalk-scrap|facebookexternalhit|Twitterbot|Slackbot).*"
        }
      ],
      "destination": "https://edu-crm-api-production.up.railway.app/og/staff/:token"
    },
    {
      "source": "/api/:path*",
      "destination": "https://edu-crm-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/|go/|alpha/|assets/|favicon.ico|robots.txt|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}